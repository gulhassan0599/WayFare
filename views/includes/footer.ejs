<div class="container">
  <div class="row gy-4 align-items-start">
    <div class="col-md-5">
      <div class="brand-mark mb-2">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="1.6"
          />
          <path
            d="M15.5 8.5L13 13L8.5 15.5L11 11L15.5 8.5Z"
            fill="currentColor"
          />
        </svg>
        Wayfare
      </div>
      <p class="mb-0" style="max-width: 36ch; opacity: 0.85">
        Handpicked places to stay, listed by people who've actually been there.
      </p>
    </div>
    <div class="col-6 col-md-3">
      <h6
        class="text-uppercase small fw-bold mb-3"
        style="letter-spacing: 0.1em; opacity: 0.7"
      >
        Explore
      </h6>
      <ul class="list-unstyled d-flex flex-column gap-2">
        <li><a href="/places">All stays</a></li>
        <li><a href="/places/new">List a place</a></li>
      </ul>
    </div>
    <div class="col-6 col-md-4">
      <h6
        class="text-uppercase small fw-bold mb-3"
        style="letter-spacing: 0.1em; opacity: 0.7"
      >
        Company
      </h6>
      <ul class="list-unstyled d-flex flex-column gap-2">
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
        <li><a href="#">Help</a></li>
      </ul>
    </div>
  </div>
  <hr class="footer-divider my-4" />
  <p class="small mb-0 text-center" style="opacity: 0.7">
    &copy; <%= new Date().getFullYear() %> Wayfare. All rights reserved.
  </p>
</div>
