<% layout('./layouts/boilerplate.ejs') %>
<div style="background-color: white; border-bottom: 1px solid rgb(179, 179, 179);"> <%- include('../includes/filters') %> </div>

    <div class="container">
        <div class="hero">
            <p class="eyebrow mb-2">Curated stays</p>
            <h1>Find a place that feels like somewhere, not anywhere.</h1>
            <p>Browse every place on Wayfare</p>
        </div>

        <% if (lists && lists.length> 0) { %>
            <div class="row g-4 pb-5">
                <% for (let list of lists) { %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <div class="place-card">

                            <a href="/listings/<%= list._id %>">
                                <div class="place-card__media">
                                    <img src="<%= list.image.url %>" alt="<%= list.image.filename %>">
                                    <span class="tag-price">
                                        Rs: <%= list.price.toLocaleString("en-PK") %> <span class="unit">/ night</span>
                                    </span>
                                </div>

                                <div class="place-card__body">
                                    <h3 class="place-card__title"><%= list.title %></h3>
                                    <p style="color: var(--color-ink-soft); line-height: 1.7;"><%= list.category %></p>
                                    <p style="color: var(--color-ink-soft); line-height: 1.7;">
                                        <% if (list.description.length> 60) { %>
                                            <%= list.description.slice(0, 65) %>...
                                        <% } else { %>
                                            <%= list.description %>
                                        <% } %>
                                    </p>
                                    <div class="place-card__location">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                            xmlns="http://www.w3.org/2000/svg">
                                            <path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"
                                                stroke="currentColor" stroke-width="1.6" />
                                            <circle cx="12" cy="9.5" r="2.3" stroke="currentColor" stroke-width="1.6" />
                                        </svg>
                                        <%= list.location %>, <%= list.country %>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                <% }; %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <h3 class="mb-2">No places listed yet</h3>
                <p class="mb-4">Once you add a place, it'll show up here as a card.</p>
                <a href="/listings/new" class="btn btn-wayfare-primary">+ Add your first place</a>
            </div>
        <% } %>
    </div>
    